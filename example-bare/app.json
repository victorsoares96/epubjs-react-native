{
  "expo": {
    "name": "example-bare",
    "slug": "example-bare",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "../plugin/withSuppressIosSelectionMenu",
      "expo-status-bar"
    ],
    "ios": {
      "bundleIdentifier": "com.jvjv33.example-bare",
      "infoPlist": {
        "UISupportsDocumentBrowser": true,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "com.jvjv33.examplebare"
    }
  }
}
